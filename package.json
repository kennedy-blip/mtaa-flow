{
  "name": "mtaa-flow",
  "private": true,
  "version": "1.2.0",
  "description": "MtaaFlow \u2014 Local Merchant & Customer Credit Ledger OS",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:open": "npx cap open android",
    "test:db": "esbuild scripts/db-test.ts --bundle --platform=node --format=esm --outfile=scripts/dist-db-test.mjs --log-level=error && node scripts/dist-db-test.mjs",
    "test:ui": "node --experimental-strip-types scripts/smoke.ts",
    "apk:build": "npm run build && npx cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "dexie": "^4.0.10",
    "dexie-react-hooks": "^1.1.7",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
